{
  "name": "ai_cli_template",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript Web App Development Template with Copilot",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:spa": "vite --config spa/vite.config.ts",
    "build:spa": "vite build --config spa/vite.config.ts",
    "preview:spa": "vite preview --config spa/vite.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docs:generate": "typedoc"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^2.1.8",
    "semantic-release": "^24.2.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
