{
  "name": "Python & Next.js Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        }
      }
    }
  },

  // ============================================
  // API Keys for AI CLIs
  // Set in Codespaces Secrets or local .env
  // Uncomment the keys you need
  // ============================================
  "containerEnv": {
    // "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    // "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    // "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  },

  // ============================================
  // AI CLI Tools Installation
  // Uncomment the tools you want to install
  // ============================================
  "postCreateCommand": {
    // GitHub Copilot CLI (default: enabled)
    "copilot": "gh extension install github/gh-copilot || true"

    // Claude Code - Uncomment to enable
    // ,"claude": "npm install -g @anthropic-ai/claude-code"

    // Gemini CLI - Uncomment to enable
    // ,"gemini": "npm install -g @google/gemini-cli"

    // OpenAI Codex - Uncomment to enable
    // ,"codex": "npm install -g @openai/codex"
  },

  "remoteUser": "vscode"
}